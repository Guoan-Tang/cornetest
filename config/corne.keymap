/* Corne Cherry v3 (42 keys), ZMK v0.3. See config/corne.conf:
 * CONFIG_ZMK_POINTING=y
 * CONFIG_ZMK_HID_CONSUMER_REPORT_USAGES_FULL=y
 *
 * Each finger row is in typing order: left six | right six. The Vial
 * layout uses the inner five columns on each half. The only added binding
 * is Studio Unlock on Nav, immediately to the left of the Q position.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Vial tapping term: 200 ms, permissive hold, repeated tap can be held. */
&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    flavor = "balanced";
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    flavor = "balanced";
};

/ {
    macros {
        translate_en: translate_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Translate EN";
            tap-ms = <10>;
            wait-ms = <10>;
            /* Vial M0: "translate to English:" then Right Shift + Enter. */
            bindings = <&macro_tap>,
                       <&kp T &kp R &kp A &kp N &kp S &kp L &kp A &kp T &kp E &kp SPACE>,
                       <&kp T &kp O &kp SPACE>,
                       <&kp LS(E) &kp N &kp G &kp L &kp I &kp S &kp H &kp COLON>,
                       <&kp RS(ENTER)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &none  &kp Q        &kp W       &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O       &kp P         &none
                &none  &mt LGUI A   &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G        &kp H        &mt RSHFT J  &mt RCTRL K  &mt RALT L  &mt RGUI SEMI &none
                &none  &kp Z        &kp X       &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA    &kp DOT     &kp FSLH      &none
                                                &lt 6 ESC    &lt 4 TAB    &lt 5 SPACE  &lt 2 ENTER  &lt 1 BSPC   &lt 3 DELETE
            >;
        };

        number_layer {
            display-name = "Num";
            bindings = <
                &none  &kp MINUS  &kp N7  &kp N8     &kp N9  &kp EQUAL      &none  &none      &none      &none     &none     &none
                &none  &kp LBKT   &kp N4  &kp N5     &kp N6  &kp RBKT       &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
                &none  &kp BSLH   &kp N1  &kp N2     &kp N3  &kp SQT        &none  &none      &none      &none     &none     &none
                                          &kp GRAVE  &kp N0  &none          &none  &none      &none
            >;
        };

        symbol_layer {
            display-name = "Sym";
            bindings = <
                &none  &kp LS(MINUS)  &kp LS(N7)  &kp LS(N8)     &kp LS(N9)  &kp LS(EQUAL)   &none  &none      &none      &none     &none     &none
                &none  &kp LS(LBKT)   &kp LS(N4)  &kp LS(N5)     &kp LS(N6)  &kp LS(RBKT)    &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
                &none  &kp LS(BSLH)   &kp LS(N1)  &kp LS(N2)     &kp LS(N3)  &kp LS(SQT)     &none  &none      &none      &none     &none     &none
                                                  &kp LS(GRAVE)  &kp LS(N0)  &none           &none  &none      &none
            >;
        };

        function_layer {
            display-name = "Fn";
            bindings = <
                &none  &kp F12  &kp F7  &kp F8  &kp F9  &none       &none  &none      &none      &none     &none     &none
                &none  &kp F11  &kp F4  &kp F5  &kp F6  &none       &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
                &none  &kp F10  &kp F1  &kp F2  &kp F3  &none       &none  &none      &none      &none     &none     &none
                                        &none   &none   &none       &none  &none      &none
            >;
        };

        navigation_layer {
            display-name = "Nav";
            bindings = <
                &studio_unlock  &none  &none  &none  &none  &none       &kp C_AC_BACK  &kp C_AC_SEARCH  &kp K_FIND  &kp C_AC_FORWARD  &translate_en  &none
                &none           &none  &none  &none  &none  &none       &kp LEFT       &kp DOWN         &kp UP      &kp RIGHT         &none          &none
                &none           &none  &none  &none  &none  &none       &kp HOME       &kp PG_DN        &kp PG_UP   &kp END           &none          &none
                                              &none  &none  &none       &none          &none            &none
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &none  &none  &none  &none  &none  &none       &none           &none           &none         &none            &none  &none
                &none  &none  &none  &none  &none  &none       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
                &none  &none  &none  &none  &none  &none       &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &none
                                     &none  &none  &none       &none           &mkp LCLK       &mkp RCLK
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &none  &none  &none  &none  &none  &none       &none       &none             &none         &none       &none  &none
                &none  &none  &none  &none  &none  &none       &kp C_PREV  &kp C_VOL_DN      &kp C_VOL_UP  &kp C_NEXT  &none  &none
                &none  &none  &none  &none  &none  &none       &none       &none             &none         &none       &none  &none
                                     &none  &none  &none       &none       &kp C_PLAY_PAUSE  &kp C_STOP
            >;
        };

        layer_7 {
            display-name = "Spare 7";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans    &trans &trans &trans
            >;
        };

        layer_8 {
            display-name = "Spare 8";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans    &trans &trans &trans
            >;
        };

        layer_9 {
            display-name = "Spare 9";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans    &trans &trans &trans
            >;
        };
    };
};
